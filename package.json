{
  "name": "colveto",
  "version": "0.5.0",
  "description": "Colveto — un logiciel par un véto, pour des vétos. Gestion de cabinet vétérinaire (rendez-vous, dossiers patients, facturation, export Sage).",
  "main": "electron/main.js",
  "author": "Colveto contributors",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^10.5.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.7",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "lu.colveto.app",
    "productName": "Colveto",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server-deploy/*.js",
      "server-deploy/public/**/*",
      "node_modules/**/*",
      "!server-deploy/backfill-*.js"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "identity": null
    },
    "linux": {
      "target": "AppImage"
    },
    "artifactName": "Colveto-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Colveto",
      "createDesktopShortcut": true
    },
    "afterSign": "build/adhoc-sign.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/"
      }
    ]
  },
  "colveto": {
    "updateRepo": "Colveto/colveto"
  }
}
